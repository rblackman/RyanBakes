{
	"name": "website",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.22.1"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"format": "pnpm -w exec biome format --write .",
		"lint": "pnpm -w exec biome check --write .",
		"typecheck": "pnpm -w exec tsc -p apps/website/tsconfig.json --noEmit",
		"prebuild": "pnpm --filter cms typegen && pnpm run validate:env",
		"predev": "pnpm run validate:env",
		"validate:env": "tsx --require dotenv/config scripts/validate-env.ts dotenv_config_path=.env"
	},
	"dependencies": {
		"@portabletext/react": "^8.0.2",
		"@ryan-bakes/sanity-types": "workspace:*",
		"@sanity/client": "^8.17.0",
		"@sanity/image-url": "^2.2.0",
		"@sanity/webhook": "^4.0.4",
		"clsx": "^2.1.1",
		"flags": "^4.5.3",
		"groq": "^6.25.0",
		"next": "^16.4.6",
		"next-sanity": "^13.5.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"sanity": "^6.25.0",
		"server-only": "^0.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@portabletext/types": "^4.0.3",
		"@vercel/toolbar": "^0.2.7",
		"dotenv": "^18.0.10",
		"next-devtools-mcp": "^0.4.0"
	}
}
