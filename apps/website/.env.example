# Copy to apps/website/.env and fill in values. Never commit the real .env.
# Validated at build and dev start by scripts/validate-env.ts (Zod schema in shared/config/env.schema.ts).
# Values live in Vercel (project env vars) and GitHub (repository variables/secrets) for CI.

# --- Public (inlined into the browser bundle) ---
# Canonical site origin, e.g. the production domain or http://localhost:3000
NEXT_PUBLIC_BASE_URL=
# Sanity project ID (8 characters)
NEXT_PUBLIC_SANITY_KEY=
# Sanity dataset name (defaults to "production" if empty)
NEXT_PUBLIC_SANITY_DATASET=
# Full URL of the hosted Sanity Studio (also the target of the /studio redirect)
NEXT_PUBLIC_SANITY_STUDIO_URL=

# --- Server only ---
# Sanity document IDs of the singleton documents
SITE_CONFIG_KEY=
RECIPES_PAGE_KEY=
TAGS_PAGE_KEY=
# Shared secret for the Sanity webhook that POSTs to /api/revalidate (secret)
SANITY_REVALIDATE_SECRET=
# Sanity API token with Viewer rights, used for draft mode and live preview (secret)
SANITY_VIEWER_TOKEN=
