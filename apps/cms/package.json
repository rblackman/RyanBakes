{
	"name": "cms",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.22.1"
	},
	"scripts": {
		"dev": "sanity dev",
		"build": "sanity build",
		"deploy": "sanity deploy",
		"schema:extract": "sanity schema extract --path ./schema.json --force",
		"typecheck": "pnpm -w exec tsc -p apps/cms/tsconfig.json --noEmit",
		"typegen": "pnpm run schema:extract && sanity typegen generate"
	},
	"dependencies": {
		"@sanity/dashboard": "^6.0.23",
		"@sanity/ui": "^4.4.14",
		"@sanity/vision": "^6.25.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"sanity": "^6.25.0",
		"styled-components": "^6.7.0"
	},
	"devDependencies": {
		"@sanity/cli": "^8.35.0"
	}
}
